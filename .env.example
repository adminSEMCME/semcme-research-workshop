NODE_ENV=production
PORT=3000
APP_BASE_URL=https://research-workshop.semcme.org
TRUST_PROXY=true
COOKIE_SECURE=true

# Reuse the shared SEMCME Postgres/Supabase database. This project creates rws_ tables.
RWS_DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
RWS_SESSION_SECRET=replace-with-a-long-random-secret

# Admin login
GLOBAL_ADMIN_USERNAME=
GLOBAL_ADMIN_PASSWORD=

# Public registration
RWS_REGISTRATION_URL=
RWS_CACHE_MINUTES=10

# Constant Contact registration lookup
CONSTANT_CONTACT_CLIENT_ID=
CONSTANT_CONTACT_CLIENT_SECRET=
# Optional at first. The admin Constant Contact reconnect flow stores fresh tokens in the database.
CONSTANT_CONTACT_ACCESS_TOKEN=
CONSTANT_CONTACT_REFRESH_TOKEN=
CONSTANT_CONTACT_RWS_EVENT_ID=
# Optional when the event has one registration track; the app can discover it from Constant Contact.
CONSTANT_CONTACT_RWS_TRACK_KEY=
CONSTANT_CONTACT_REGISTRATION_RECHECK_MINUTES=60

# Email delivery through Resend SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=SEMCME Research Workshop Series <research@mail.semcme.org>
